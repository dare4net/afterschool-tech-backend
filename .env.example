# Express listen port
PORT=5001

# Mongo connection for the main + lessons databases
MONGODB_URI=

# Shared with the Next.js app. Must match ast4-lesson-builder JWT_SECRET.
JWT_SECRET=

# Platform superadmin console (frontend route /superadmin).
# Credentials cannot be changed in the app — only here.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional
SENTRY_DSN=
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Closed-app push (FCM). Paste the Firebase service-account JSON as one line.
# Superadmin Jobs → Run will not ping phones until this is set.
FIREBASE_SERVICE_ACCOUNT=

# Origin used for notification click-through (PWA / Next app).
PUBLIC_APP_URL=https://app.after-school.tech

